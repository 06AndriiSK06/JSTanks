{
	"name": "@jstanks/shared",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./sim": {
			"types": "./src/sim/index.ts",
			"default": "./dist/sim/index.js"
		},
		"./protocol": {
			"types": "./src/protocol.ts",
			"default": "./dist/protocol.js"
		},
		"./codec": {
			"types": "./src/codec/binary.ts",
			"default": "./dist/codec/binary.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"zod": "^3.24.1"
	}
}
