{
	"name": "@jstanks/server",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir src",
		"start": "node --import tsx --env-file=.env src/index.ts",
		"dev": "node --import tsx --env-file=.env --watch src/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"bench:rss": "node test/backpressure-bench.js"
	},
	"dependencies": {
		"@jstanks/shared": "*",
		"pino": "^10.4.0",
		"prom-client": "^15.1.3",
		"ws": "^8.18.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/ws": "^8.5.13"
	}
}
