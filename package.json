{
	"name": "jstanks",
	"private": true,
	"version": "0.6.0",
	"workspaces": [
		"client",
		"server",
		"shared"
	],
	"scripts": {
		"dev:server": "npm --workspace=@jstanks/server run dev",
		"dev:client": "npm --workspace=@jstanks/client run dev",
		"build": "npm --workspace=@jstanks/client run build",
		"start": "npm --workspace=@jstanks/server run start",
		"test": "node --import tsx --test shared/test/*.test.ts",
		"typecheck": "npm --workspace=@jstanks/shared run typecheck && npm --workspace=@jstanks/server run typecheck && npm --workspace=@jstanks/client run typecheck",
		"format": "biome format --write .",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
