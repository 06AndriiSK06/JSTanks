{
	"name": "jstanks",
	"private": true,
	"version": "0.5.0",
	"workspaces": [
		"client",
		"server",
		"shared"
	],
	"scripts": {
		"dev:server": "npm --workspace=@jstanks/server run dev",
		"dev:client": "npm --workspace=@jstanks/client run dev",
		"build": "npm --workspace=@jstanks/client run build",
		"start": "npm --workspace=@jstanks/server run start",
		"test": "node --test shared/test/*.test.js",
		"format": "biome format --write .",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12"
	}
}
